# Jan Ganana AI Environment Variables Example

# Hugging Face Access Token (Optional: app falls back to local intelligent RAG/heuristic engine if not set)
HF_TOKEN=

# Cryptographic JWT Secret for Citizen Session Authentication (Set strong 64-char random hex in production)
JWT_SECRET=replace_with_strong_random_jwt_secret_hex_key

# Admin Secret Key for updating live schedules & FAQs via x-admin-key header
ADMIN_SECRET_KEY=replace_with_secure_admin_api_secret_key

# Phone Hash Pepper / Salt (DPDP Act 2023 pseudonymization)
PHONE_HASH_SALT=replace_with_cryptographic_random_salt

# Security Flags
ALLOW_DEMO_OTP=false
NODE_ENV=production

# Optional: set on Vercel so frontend /api/v1 requests proxy to the Render backend
API_PROXY_TARGET=
